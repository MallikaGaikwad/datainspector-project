{
    "columns": {
      "employee_id": {
        "type": "int",
        "required": true,
        "min": 1
      },
      "age": {
        "type": "int",
        "required": true,
        "min": 18,
        "max": 80
      },
      "income": {
        "type": "float",
        "required": true,
        "min": 0
      },
      "plan": {
        "type": "string",
        "required": true,
        "allowed": ["Basic", "Standard", "Premium"]
      },
      "join_date": {
        "type": "date",
        "required": true
      },
      "email": {
        "type": "string",
        "required": true,
        "regex": "[^@\\s]+@[^@\\s]+\\.[^@\\s]+"
      }
    }
  }  